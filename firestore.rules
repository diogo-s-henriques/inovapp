rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // O papel deixou de ser uma porta de entrada. O registo aceita qualquer email (é isso que
    // torna a distribuição pública da app uma afirmação verdadeira - ver a diretriz 3.2 da Apple
    // no STORE.md) e quem entra com um endereço de fora é **aluno**. O que continua presa ao
    // domínio é só o rótulo de **docente do ISEC**: é um rótulo que a instituição empresta, e por
    // isso não pode ser uma escolha de quem se regista. Sem esta parte, um cliente feito à mão
    // escrevia `role: 'professor'` com um email qualquer e aparecia no diretório como docente.
    function isIsecTeacherEmail() {
      return request.auth.token.email.matches('(?i)^[^@]+@iseclisboa\\.pt$');
    }

    function roleAllowedForEmail(role) {
      return (role == 'student' && !isIsecTeacherEmail())
        || (role == 'professor' && isIsecTeacherEmail());
    }

    // A caixa de correio institucional **confirmada** - o link que o Firebase manda ao registar e
    // que só quem lê aquele email pode abrir.
    //
    // É esta a peça que o domínio do email não dá: `roleMatchesEmailDomain` só garante que o
    // endereço *parece* institucional, e qualquer pessoa o pode escrever ao criar a conta (o dono
    // verdadeiro descobre depois, quando o Firebase lhe disser que o email já está em uso). Com
    // esta função, um email que ninguém provou ser seu não lê nem escreve nada.
    function isVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Campos privados da conta. Nunca podem ser criados em `users`, que é legível por qualquer
    // utilizador autenticado - o sítio deles é userAccounts/{uid}.
    function hasNoPrivateAccountFields(data) {
      return !('email' in data) && !('lastLoginAt' in data) && !('rememberSession' in data);
    }

    // Perfis criados antes da separação userAccounts ainda têm estes campos dentro de `users`.
    // Não se exige que desapareçam já (senão qualquer update a um perfil antigo falhava), mas
    // também não podem ser alterados nem acrescentados. A limpeza acontece no primeiro login
    // a seguir à atualização (ver signIn em src/auth/actions.ts).
    function privateFieldsUnchanged(data, current) {
      return (!('email' in data) || data.email == current.get('email', null))
        && (!('lastLoginAt' in data) || data.lastLoginAt == current.get('lastLoginAt', null))
        && (!('rememberSession' in data) || data.rememberSession == current.get('rememberSession', null));
    }

    // Um bloqueio é guardado num sentido só (`blocks/{blocker}_{blocked}`), mas o efeito é
    // simétrico: basta existir num dos sentidos para o par deixar de se poder ligar, falar ou
    // pedir sessão. A função é usada, entre outros, por regras em que quem avalia NÃO consegue
    // ler o documento do bloqueio (a pessoa bloqueada) - get()/exists() em regras correm com
    // acesso total, não com as permissões de quem fez o pedido, e é isso que permite bloquear
    // sem revelar o bloqueio.
    function isBlocked(uidA, uidB) {
      return exists(/databases/$(database)/documents/blocks/$(uidA + '_' + uidB))
        || exists(/databases/$(database)/documents/blocks/$(uidB + '_' + uidA));
    }

    match /blocks/{blockId} {
      // Legível pelos dois lados. É o que deixa cada um excluir o outro da descoberta sem
      // falar com o servidor, e é uma consequência assumida: um cliente modificado consegue
      // descobrir quem o bloqueou. O documento só tem os dois UIDs - nenhum dado pessoal.
      allow read: if isVerified()
        && (resource.data.blocker == request.auth.uid || resource.data.blocked == request.auth.uid);
      allow create: if isVerified()
        && request.resource.data.blocker == request.auth.uid
        && request.resource.data.blocked != request.auth.uid
        && blockId == request.resource.data.blocker + '_' + request.resource.data.blocked;
      // Desbloquear - e só pelo autor do bloqueio: ninguém desfaz o bloqueio de outra pessoa.
      allow delete: if isVerified() && resource.data.blocker == request.auth.uid;
      allow update: if false;
    }

    match /users/{userId} {
      // Perfis são legíveis pelos utilizadores **confirmados** (pesquisa/matching precisam de ver
      // outros perfis) - por isso este documento só pode conter o que é partilhado dentro da
      // comunidade: nada de email, última entrada ou "lembrar sessão" (ver userAccounts).
      //
      // O próprio lê sempre o seu, confirmado ou não: é esta leitura que diz à app se o perfil
      // está completo, e sem ela quem ainda não confirmou o email ficava preso num carregamento
      // infinito - o ecrã que explica o que falta nunca chegava a aparecer (ver src/lib/auth-gate.ts).
      allow read: if isVerified() || (request.auth != null && request.auth.uid == userId);
      // O `create` acontece no registo, **antes** de haver confirmação nenhuma - e é por isso que
      // ele é a única porta aberta a quem não confirmou. Está fechado ao que o registo escreve, e
      // só a isso: sem a segunda condição, um cliente feito à mão criava aqui um perfil completo
      // (nome, disciplinas, `profileCompleted: true`) em nome de outra pessoa, que é exatamente o
      // que a confirmação do email existe para impedir.
      allow create: if request.auth != null && request.auth.uid == userId
        && hasNoPrivateAccountFields(request.resource.data)
        && roleAllowedForEmail(request.resource.data.role)
        && (
          isVerified()
          || (request.resource.data.profileCompleted == false
            && request.resource.data.keys().hasOnly(['role', 'profileCompleted', 'createdAt']))
        );
      // Editar o perfil (o nome, as disciplinas, a fotografia) exige o email confirmado.
      allow update: if isVerified() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && privateFieldsUnchanged(request.resource.data, resource.data);
      // Apagar o próprio perfil - o primeiro passo de apagar a conta (ver src/lib/account.ts).
      //
      // Aqui **não** se exige o email confirmado, ao contrário do `update` logo acima, e a diferença
      // é o que cada operação pode fazer de mal. O `update` escreve em nome de alguém (é por isso
      // que a confirmação existe); o `delete` do próprio documento não escreve nada nem deixa
      // ninguém falar com ninguém - e exigi-la aqui fechava a porta a quem se registou com um email
      // institucional que não consegue confirmar (perdeu o acesso à caixa, por exemplo) e ficava com
      // uma conta que não podia remover.
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Registos de avisos push deste dispositivo: `users/{uid}/devices/{id}` com o token da Expo
      // (ver src/lib/push.ts). Só o próprio lê e escreve - um token, para quem o tenha, é uma forma
      // de mandar avisos em nome da app, e é por isso que ele não pode viver no documento do perfil
      // (esse é legível por toda a gente). Quem envia, mais tarde, serão as Cloud Functions, que não
      // passam por estas regras.
      //
      // Leitura e apagar ficam sem validação de campos de propósito: no `read` e no `delete` o
      // `request.resource` é nulo, e uma condição que o lesse rejeitava as duas operações.
      // O registo dos avisos não exige o email confirmado: só o próprio lá chega e não serve para
      // falar com ninguém (e o `usePushSync` só corre com o perfil completo, ou seja, já depois
      // da confirmação).
      match /devices/{deviceId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.platform in ['android', 'ios'];
      }
    }

    match /userAccounts/{userId} {
      // Dados privados da conta: email institucional, data da última entrada e se a sessão
      // deve ser prolongada. Só o próprio os lê.
      //
      // Aqui **não** se exige o email confirmado, de propósito: é o documento que o login escreve a
      // cada entrada (a última entrada e o "lembrar-me"), e quem não confirmou tem de conseguir
      // entrar para chegar ao ecrã que explica como confirmar. Não abre nada: o documento é só do
      // próprio e não tem nada que sirva para falar com outra pessoa.
      allow read: if request.auth != null && request.auth.uid == userId;
      // O email gravado tem de ser o mesmo do token autenticado (impede um cliente feito à mão
      // de se registar com o email de outra pessoa).
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && roleAllowedForEmail(request.resource.data.role);
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role;
      // Os dados privados da conta vão atrás dela quando ela é apagada. O documento é só do próprio
      // (ninguém o lê nem o escreve), por isso apagá-lo não abre nada a mais.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /connectionRequests/{requestId} {
      allow read: if isVerified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      // Só o Tutorando (from) inicia o pedido; nunca o Mentor/Tutor (to != from garante um sentido só).
      allow create: if isVerified()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        && requestId == request.resource.data.from + '_' + request.resource.data.to
        && !isBlocked(request.resource.data.from, request.resource.data.to);
      // Só o destinatário (to) aceita/recusa, e só enquanto ainda estiver pendente.
      allow update: if isVerified()
        && request.auth.uid == resource.data.to
        && resource.data.status == 'pending'
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.status in ['accepted', 'declined']
        && !isBlocked(resource.data.from, resource.data.to);
      // Apagar o pedido quando a conta de um dos dois desaparece. Ao contrário do `update` (que é só
      // do destinatário e só enquanto está pendente), aqui qualquer dos dois lados pode levar o
      // pedido: é o que impede o outro de ficar com um pedido pendente de alguém que já não existe.
      allow delete: if isVerified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /sessionRequests/{requestId} {
      allow read: if isVerified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      // Qualquer um dos dois lados de uma ligação já aceite pode pedir uma sessão ao outro
      // (ao contrário do connectionRequest, que é sempre Tutorando -> Mentor).
      allow create: if isVerified()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == 'pending'
        // Só é possível pedir sessão se já existir um pedido de conexão aceite entre os dois
        // (nos dois sentidos possíveis, porque o pedido de sessão pode partir de qualquer lado).
        && (
          (exists(/databases/$(database)/documents/connectionRequests/$(request.resource.data.from + '_' + request.resource.data.to))
            && get(/databases/$(database)/documents/connectionRequests/$(request.resource.data.from + '_' + request.resource.data.to)).data.status == 'accepted')
          ||
          (exists(/databases/$(database)/documents/connectionRequests/$(request.resource.data.to + '_' + request.resource.data.from))
            && get(/databases/$(database)/documents/connectionRequests/$(request.resource.data.to + '_' + request.resource.data.from)).data.status == 'accepted')
        )
        && !isBlocked(request.resource.data.from, request.resource.data.to);
      // Só o destinatário (to) aceita/recusa, e só enquanto ainda estiver pendente.
      allow update: if isVerified()
        && request.auth.uid == resource.data.to
        && resource.data.status == 'pending'
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.status in ['accepted', 'declined']
        && !isBlocked(resource.data.from, resource.data.to);
      // O mesmo do pedido de conexão: qualquer dos dois lados leva o pedido quando a conta de um
      // deles desaparece.
      allow delete: if isVerified()
        && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /sessions/{sessionId} {
      allow read: if isVerified() && request.auth.uid in resource.data.participants;
      // Só quem aceitou o pedido (o mentor) pode criar a sessão, e só se existir mesmo um
      // sessionRequest por trás, com o par from/to correspondente. A condição verifica
      // status == 'pending' (não 'accepted'): esta escrita acontece no mesmo writeBatch que
      // marca o sessionRequest como aceite, e get()/exists() em regras leem sempre o estado
      // anterior ao batch, nunca as escritas ainda pendentes desse mesmo batch - exigir
      // 'accepted' aqui faria esta condição falhar sempre. Continua seguro porque só o próprio
      // destinatário (to == mentorUid, já garantido acima) pode desencadear isto.
      allow create: if isVerified()
        && request.auth.uid == request.resource.data.mentorUid
        && request.resource.data.participants.size() == 2
        && (
          request.resource.data.participants == [request.resource.data.studentUid, request.resource.data.mentorUid]
          || request.resource.data.participants == [request.resource.data.mentorUid, request.resource.data.studentUid]
        )
        && get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.sessionRequestId)).data.from == request.resource.data.studentUid
        && get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.sessionRequestId)).data.to == request.resource.data.mentorUid
        && get(/databases/$(database)/documents/sessionRequests/$(request.resource.data.sessionRequestId)).data.status == 'pending'
        && !isBlocked(request.resource.data.studentUid, request.resource.data.mentorUid);
      // Só o mentor pode terminar a sessão, só de 'scheduled' para 'completed' (nunca o
      // contrário), e só isso muda - nenhum outro campo pode ser alterado no mesmo update.
      // get('status', 'scheduled') trata sessões antigas sem o campo 'status' (criadas antes
      // desta funcionalidade existir) como 'scheduled' - sem isto, essa leitura direta rebentava
      // para esses documentos e o mentor nunca conseguia terminá-las.
      allow update: if isVerified()
        && request.auth.uid == resource.data.mentorUid
        && resource.data.get('status', 'scheduled') == 'scheduled'
        && request.resource.data.status == 'completed'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completedAt']);
      // A sessão vai atrás da conta de quem participou nela (ver src/lib/account.ts). A avaliação
      // que porventura exista (`ratings/{sessionId}`) **não** é apagada, e é por isso que ela fica
      // inalcançável em vez de removida: sem a sessão, o ecrã que a mostra não tem por onde lá
      // chegar, e abrir-lhe o `delete` deixava um mentor apagar as notas más que recebeu - que é
      // exatamente o que o anonimato existe para impedir.
      allow delete: if isVerified() && request.auth.uid in resource.data.participants;
    }

    match /ratings/{sessionId} {
      // ID = ID da sessão (não de quem avalia) e o documento nunca guarda quem escreveu -
      // a regra confirma que quem escreve é o Tutorando da sessão sem persistir essa ligação.
      allow read: if isVerified();
      allow create: if isVerified()
        && get(/databases/$(database)/documents/sessions/$(sessionId)).data.studentUid == request.auth.uid
        && request.resource.data.mentorUid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.mentorUid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow read, update: if isVerified() && request.auth.uid in resource.data.participants;
      // Só é possível criar a conversa se existir um pedido de conexão pendente entre os dois
      // participantes, dirigido a quem está a criar a conversa (nos dois sentidos possíveis,
      // porque o ID do pedido é sempre tutorandoUid_mentorUid, enquanto o ID da conversa vem
      // ordenado). A condição verifica status == 'pending' (não 'accepted'): esta escrita
      // acontece no mesmo writeBatch que marca o connectionRequest como aceite, e get()/exists()
      // em regras leem sempre o estado anterior ao batch, nunca as escritas ainda pendentes
      // desse mesmo batch - exigir 'accepted' aqui faria esta condição falhar sempre. Continua
      // seguro porque exige também que quem cria seja o destinatário (to) desse pedido, ou seja,
      // a mesma pessoa que só podia aceitá-lo de qualquer forma.
      allow create: if isVerified()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && conversationId == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
        && (
          (exists(/databases/$(database)/documents/connectionRequests/$(request.resource.data.participants[0] + '_' + request.resource.data.participants[1]))
            && get(/databases/$(database)/documents/connectionRequests/$(request.resource.data.participants[0] + '_' + request.resource.data.participants[1])).data.status == 'pending'
            && get(/databases/$(database)/documents/connectionRequests/$(request.resource.data.participants[0] + '_' + request.resource.data.participants[1])).data.to == request.auth.uid)
          ||
          (exists(/databases/$(database)/documents/connectionRequests/$(request.resource.data.participants[1] + '_' + request.resource.data.participants[0]))
            && get(/databases/$(database)/documents/connectionRequests/$(request.resource.data.participants[1] + '_' + request.resource.data.participants[0])).data.status == 'pending'
            && get(/databases/$(database)/documents/connectionRequests/$(request.resource.data.participants[1] + '_' + request.resource.data.participants[0])).data.to == request.auth.uid)
        )
        && !isBlocked(request.resource.data.participants[0], request.resource.data.participants[1]);
      // A conversa é dos dois, e levá-la é o que resta a quem apaga a conta: sem o documento, a
      // lista de conversas de quem fica apontava para alguém que já não existe. (As mensagens que
      // **ele** escreveu são apagadas antes disso - ver src/lib/account.ts -, e as outras ficam
      // inalcançáveis, porque é a conversa que a regra abaixo lê para deixar ler lá dentro.)
      allow delete: if isVerified() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        // Um bloqueio entre os dois participantes corta a conversa para ambos: ninguém lê nem
        // escreve mais nada ali. O histórico não é apagado (nada neste projeto apaga), fica
        // inacessível - que é o que "bloquear" tem de significar para ser levado a sério.
        allow read: if isVerified()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && !isBlocked(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]);
        allow create: if isVerified()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && !isBlocked(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[0],
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[1]);
        // Apagar as **próprias** mensagens: é o que leva o texto de quem apaga a conta, e é o que
        // impede isto de ser mais do que isso. Deixar apagar qualquer mensagem da conversa a quem
        // dela participa era dar a cada um o poder de apagar o que o outro escreveu - o oposto do
        // caminho que este ficheiro seguiu desde o princípio (só o autor desfaz o que é seu).
        allow delete: if isVerified() && resource.data.senderId == request.auth.uid;
        allow update: if false;
      }
    }
  }
}
