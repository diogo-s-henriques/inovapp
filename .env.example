# Copia este ficheiro para .env e preenche com os dados do projeto Firebase
# (Consola Firebase > Definições do projeto > As tuas apps > Configuração do SDK).
# Sem estes valores a app arranca mas não consegue ligar-se ao Firebase.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
