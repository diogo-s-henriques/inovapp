# Copia este ficheiro para .env e preenche com os dados do projeto Firebase
# (Consola Firebase > Definições do projeto > As tuas apps > Configuração do SDK).
#
# Sem estes valores a app **fecha no arranque**, e não é uma figura de estilo: a Auth do Firebase é
# construída no topo do `src/lib/firebase.ts` (`export const auth = createAuth()`) e recusa um apiKey
# vazio com `auth/invalid-api-key`. Um `throw` ao avaliar um módulo acontece antes de haver ecrã
# nenhum, por isso nenhum dos limites de erro da app o apanha. (Este comentário dizia que a app
# arrancava sem eles; era falso, e foi essa suposição que deixou passar as builds de loja sem
# configuração nenhuma.)
#
# Este ficheiro serve o **desenvolvimento** - o `expo start` lê o .env. **As builds do EAS não o
# leem**: o .env está no .gitignore, portanto não sobe para o construtor. Os mesmos seis valores
# vivem em `eas.json` (perfil `base`, herdado pelos três perfis), e é de lá que a build de loja os
# tira. `tests/lib/eas-env.test.mts` falha se os dois lados divergirem.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
