{
  "name": "inovapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.6",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-video": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^26.5.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "firebase-admin": "^14.4.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "npm run test:lib && npm run test:data && npm run test:components && npm run test:rules",
    "test:components": "jest",
    "test:data": "npx firebase-tools emulators:exec --only firestore,auth --project inovapp-68021 \"node --import ./tests/data/preload.mjs --test --test-concurrency=1 --test-force-exit tests/data/*.test.mts\"",
    "test:lib": "node --import ./tests/register-loader.mjs --test \"tests/lib/*.test.mts\"",
    "test:rules": "npx firebase-tools emulators:exec --only firestore --project inovapp-68021 \"node --test tests/firestore-rules.test.mts\"",
    "typecheck:tests": "tsc --noEmit -p tests/tsconfig.json",
    "cleanup:legacy-profiles": "node scripts/cleanup-legacy-profiles.js"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/tests/components/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "setupFiles": [
      "<rootDir>/tests/components/jest-setup.ts"
    ]
  },
  "private": true
}
